APP_NAME=jvmeta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Primary database (System of Record). Default = bundled Compose `postgres`.
# External DB: point DB_HOST/DB_PORT to the remote host and keep creds here.
# MySQL/MariaDB: switch DB_CONNECTION=mysql (pdo_mysql ships in the image).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jvmeta
DB_USERNAME=jvmeta
DB_PASSWORD=jvmeta
DB_SSLMODE=prefer

# Host-side bind ports for the bundled internal DB services. Change these when
# an external DB already occupies the default host port. Ignored if you use
# external databases and `docker compose stop postgres mongo elasticsearch`.
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
ELASTICSEARCH_HOST_PORT=9200

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mongo archive (per-site raw snapshots + activity log). Default = bundled
# Compose `mongo`. External Mongo: set MONGO_URI to a full connection string
# (takes precedence over MONGO_HOST/PORT), or point MONGO_HOST/PORT remote.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=jvmeta_archive
MONGO_URI=
ACTIVITY_LOG_CONNECTION=mongodb
ACTIVITY_LOG_COLLECTION=activity_logs

# Elasticsearch search index. Default = bundled Compose `elasticsearch`.
# External ES: point ELASTICSEARCH_HOST to the remote URL.
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_MOVIES_INDEX=jvmeta_movies
ELASTICSEARCH_PERFORMERS_INDEX=jvmeta_performers

# crawlerx browser chain (Playwright / stealth / FlareSolverr)
CRAWLERX_NODE=node
CRAWLERX_PLAYWRIGHT_SCRIPT=/var/www/crawlerx/scripts/playwright-fetch.mjs
CRAWLERX_PUPPETEER_SCRIPT=/var/www/crawlerx/scripts/puppeteer-stealth-fetch.mjs
CRAWLERX_FLARESOLVERR_URL=http://flaresolverr:8191/v1
JVMETA_FETCH_PROFILE=browser_likely
JVMETA_FETCH_TIMEOUT=90
JVMETA_WORKERS_PER_QUEUE=1
JVMETA_QUEUE_NAMES=listing,detail,performer_listing,performer_detail,gallery

# Alerts via jooservices/laravel-notifications (Telegram channel)
# NOTIFICATION_TELEGRAM_* preferred; TELEGRAM_* kept as legacy fallback
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JVMETA_OWNER_ADMIN_TOKEN=
# Active jvm_… key required for `php artisan mcp:serve` / compose profile mcp
JVMETA_MCP_API_KEY=

# OpenObserve (Compose service `openobserve`, UI http://localhost:5080)
OPENOBSERVE_ENABLED=true
OPENOBSERVE_URL=http://openobserve:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM_LOGS=jvmeta_logs
OPENOBSERVE_STREAM_METRICS=jvmeta_metrics
OPENOBSERVE_EMAIL=root@jvmeta.local
OPENOBSERVE_PASSWORD=Complexpass#123
OPENOBSERVE_TIMEOUT=3
OPENOBSERVE_TRACE_SAMPLE_RATE=1.0
ZO_ROOT_USER_EMAIL=root@jvmeta.local
ZO_ROOT_USER_PASSWORD=Complexpass#123
LOG_STACK=single,openobserve
