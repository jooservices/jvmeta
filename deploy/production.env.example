# Copy this file to a private deployment host as deploy/production.env.
# Do not commit the copied file or put credentials in this template.

JVMETA_ENV_FILE=deploy/production.env
JVMETA_IMAGE=jvmeta:deploy-REPLACE_WITH_VERSION
JVMETA_EMBEDDER_IMAGE=jvmeta-embedder:deploy-REPLACE_WITH_VERSION
FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:v3.4.1
JVMETA_API_BIND=127.0.0.1:8080
# Keep loopback for control-only operation. Set this to the control host's
# private/LAN address before external crawler nodes call the embedder.
JVMETA_EMBEDDER_BIND=127.0.0.1:8000

APP_NAME=jvmeta
APP_ENV=production
APP_DEBUG=false
APP_KEY=replace-with-a-runtime-secret
APP_URL=http://127.0.0.1:8080

# External PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=replace-with-postgres-host
DB_PORT=5432
DB_DATABASE=jvmeta
DB_USERNAME=replace-with-postgres-user
DB_PASSWORD=replace-with-postgres-password
DB_SSLMODE=prefer

# External MongoDB
QUEUE_CONNECTION=database
CACHE_STORE=database
# Worker timeout; keep it below the database queue retry window.
JVMETA_QUEUE_TIMEOUT=180
# Database jobs remain reserved beyond the worker timeout.
DB_QUEUE_RETRY_AFTER=240
MONGO_URI=mongodb://replace-with-mongo-host:27017
MONGO_HOST=replace-with-mongo-host
MONGO_PORT=27017
MONGO_DATABASE=jvmeta_archive
ACTIVITY_LOG_CONNECTION=mongodb
ACTIVITY_LOG_COLLECTION=activity_logs

# External Elasticsearch
ELASTICSEARCH_HOST=https://replace-with-elasticsearch-host:9200
ELASTICSEARCH_MOVIES_INDEX=jvmeta_movies
ELASTICSEARCH_PERFORMERS_INDEX=jvmeta_performers

# Crawler runtime
CRAWLERX_NODE=node
CRAWLERX_PLAYWRIGHT_SCRIPT=/var/www/html/vendor/jooservices/crawlerx/scripts/playwright-fetch.mjs
CRAWLERX_PUPPETEER_SCRIPT=/var/www/html/vendor/jooservices/crawlerx/scripts/puppeteer-stealth-fetch.mjs
CRAWLERX_FLARESOLVERR_URL=http://flaresolverr:8191/v1
CRAWLERX_FLARESOLVERR_REQUIRED=true
JVMETA_WORKERS_PER_QUEUE=1
JVMETA_QUEUE_NAMES=listing,detail,performer_listing,performer_detail,gallery

# External OpenObserve
OPENOBSERVE_ENABLED=false
OPENOBSERVE_URL=http://replace-with-openobserve-host:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM_LOGS=jvmeta_logs
OPENOBSERVE_STREAM_METRICS=jvmeta_metrics
OPENOBSERVE_EMAIL=replace-with-openobserve-email
OPENOBSERVE_PASSWORD=replace-with-openobserve-password
OPENOBSERVE_TIMEOUT=3
OPENOBSERVE_TRACE_SAMPLE_RATE=1.0
LOG_STACK=single,openobserve

# Application credentials
JVMETA_ALERTS_ENABLED=false
JVMETA_OWNER_ADMIN_TOKEN=replace-with-owner-admin-token
JVMETA_MCP_API_KEY=replace-with-mcp-api-key
