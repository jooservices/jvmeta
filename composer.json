{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jooservices/jvmeta",
    "type": "project",
    "description": "Laravel POC API and crawl worker for JAV metadata normalization.",
    "keywords": [
        "jvmeta",
        "laravel",
        "metadata",
        "poc"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "jooservices/client": "^4.0",
        "jooservices/crawlerx": "*",
        "jooservices/dto": "^3.0",
        "jooservices/exceptions": "^4.0",
        "jooservices/laravel-controller": "^4.0",
        "jooservices/laravel-logging": "^4.0",
        "jooservices/laravel-notifications": "^1.0.1",
        "jooservices/laravel-repository": "^4.0",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "mongodb/mongodb": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "captainhook/captainhook": "^5.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "hooks:install": "captainhook install --force --skip-existing",
        "lint": "pint --test",
        "lint:fix": "pint",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php -r \"file_exists('.env') || touch('.env');\"",
            "@php artisan config:clear --ansi",
            "APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= APP_NAME=jvmeta php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jooservices/laravel-notifications.git"
        },
        {
            "name": "laravel-logging",
            "type": "path",
            "url": "../laravel-logging",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../client",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../crawlerx",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../dto",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../exceptions",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel-controller",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel-repository",
            "canonical": false,
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
