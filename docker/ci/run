#!/usr/bin/env bash
# Run a command inside the CI image with the repository mounted at /app.
#   docker/ci/run composer lint
set -euo pipefail

image="${JVMETA_CI_IMAGE:-jvmeta-ci:local}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [[ "${JVMETA_CI_SKIP_BUILD:-0}" != "1" ]]; then
  docker build --quiet --tag "${image}" --file "${root}/docker/ci/Dockerfile" "${root}/docker/ci" >/dev/null
fi

exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp \
  --volume "${root}:/app" \
  --volume "${JVMETA_CI_COMPOSER_CACHE:-jvmeta-ci-composer-cache}:/tmp/composer-cache" \
  --workdir /app \
  "${image}" "$@"
